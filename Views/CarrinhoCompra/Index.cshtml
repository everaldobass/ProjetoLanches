@model CarrinhoCompraViewModel
<style>
    .carrinho img {
        height: 80px; /* altura desejada */
        object-fit: cover; /* corta a imagem sem distorcer */
        margin-top: 80px;
        margin-bottom:15px;
        width: 100%;
        border-radius: 10px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }
</style>

<div class="container container w-100">

    <div class="carrinho d-block w-100">
        <img src="https://plus.unsplash.com/premium_photo-1661434758776-faf568a8a34f?q=80&w=1031&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="Alternate Text" />
    </div>


    <div>

        <div class="card shadow-lg border-0 rounded-3">

            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">

                <h4 class="mb-0">🛒 Seu Carrinho de Compras</h4>
                <a asp-controller="Lanche" asp-action="List" class="btn btn-outline-light btn-sm">
                    Continuar Comprando
                </a>
            </div>

            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th class="text-center">Quantidade</th>
                                <th>Lanche</th>
                                <th class="text-end">Preço</th>
                                <th class="text-end">Subtotal</th>

                                <th class="text-center">Remover</th>
                            </tr>
                        </thead>



                        <tbody>


                            @foreach (var item in Model.CarrinhoCompra.CarrinhoCompraItems)
                            {
                                <tr>
                                    <td class="text-center fw-bold">@item.Quantidade</td>
                                    <td>@item.Lanche.Nome</td>
                                    <td class="text-end">@item.Lanche.Preco.ToString("C")</td>

                                    <td class="text-end">@((item.Quantidade * item.Lanche.Preco).ToString("C"))</td>

                                    <td class="text-center">
                                        <a asp-controller="CarrinhoCompra" asp-action="RemoverItemDoCarrinhoCompra"
                                           asp-route-lancheId="@item.Lanche.LancheId"
                                           class="btn btn-sm btn-outline-danger rounded-circle">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Total:</td>
                                <td class="text-end fw-bold text-success">
                                    @Model.CarrinhoCompraTotal.ToString("C")
                                </td>
                            </tr>
                        </tfoot>

                    </table>
                </div>
            </div>

            <div class="card-footer d-flex justify-content-end gap-2">

                <a asp-controller="Pedido" asp-action="Checkout" class="btn btn-success btn-lg">
                    Finalizar Pedido 
                </a>

            </div>
        </div>
    </div>
</div>
