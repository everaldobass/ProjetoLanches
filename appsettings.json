    // Conexão com banco de dados SQL Server, usando instância local chamada SQLEXPRESS
    // 'dbautenticacao' é o nome do banco, e a conexão é feita com autenticação integrada do Windows
    "DefaultConnectionSqlServer": "Server=DESKTOP-R2E5LVV\\SQLEXPRESS; Database=dbautenticacao; trusted_connection=true; trustservercertificate=true"
  }

}
