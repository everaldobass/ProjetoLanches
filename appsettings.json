{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {

    // Conexão com banco de dados SQLite, usando um arquivo local chamado LanchesDatase.db
    "DefaultConnectionSqlite": "Data Source=LanchesDatase.db",

    // Conexão com banco de dados MySQL, rodando localmente na porta 3306
